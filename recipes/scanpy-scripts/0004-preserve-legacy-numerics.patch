+# Derived from Scanpy 1.9.3 (BSD-3-Clause); scoped Scrublet PCA pipelines.
+# See LICENSE.scanpy, LICENSE.sklearn, LICENSE.scipy and LICENSE.scrublet.
+from anndata import AnnData
+from typing import Optional
+import numpy as np
+import pandas as pd
+from scipy import sparse
+
+
+from scanpy import logging as logg
+from scanpy import preprocessing as pp
+from scanpy.get import _get_obs_rep
+
+
+def scrublet(
+    adata: AnnData,
+    adata_sim: Optional[AnnData] = None,
+    batch_key: str = None,
