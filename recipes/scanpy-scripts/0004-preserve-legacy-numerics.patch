--- a/scanpy_scripts/_legacy_numerics.py
+++ b/scanpy_scripts/_legacy_numerics.py
@@ -0,0 +1,50 @@
+"""Legacy numerical behavior during scanpy-scripts CLI commands only.
+
+Bindings are restored on return or exception. Importing the library does not
+activate these hooks. They temporarily affect dependency modules in this
+process, so CLI callbacks should not run concurrently with unrelated analysis.
+SciPy and sklearn versions are constrained by the Conda recipe.
+"""
+from contextlib import ExitStack, contextmanager
+from importlib import import_module
+from unittest.mock import patch
+
+
+@contextmanager
+def legacy_numerics():
+    import numpy as np
+    from scipy.sparse import coo_matrix
+    import scipy.sparse.linalg as sla
+    import sklearn.manifold as manifold
+    from ._legacy_svds import svds
+
+    scanpy_pca = import_module('scanpy.preprocessing._pca')
+    sklearn_pca = import_module('sklearn.decomposition._pca')
+    sklearn_svd = import_module('sklearn.decomposition._truncated_svd')
+    original_sum = coo_matrix.sum_duplicates
+    original_tsne = manifold.TSNE
+
+    def column_ordered_sum(self):
+        original_sum(self)
+        order = np.lexsort((self.row, self.col))
+        self.row, self.col = self.row[order], self.col[order]
+        self.data = self.data[order]
+        self.has_canonical_format = True  # SciPy <=1.10 convention
+
+    def compatible_tsne(*args, **kwargs):
+        # Ignored since sklearn 1.1; removed from its constructor in 1.3.
+        kwargs.pop('square_distances', None)
+        return original_tsne(*args, **kwargs)
+
+    replacements = (
+        (sla, 'svds', svds),
+        (scanpy_pca, 'svds', svds),
+        (sklearn_pca, 'svds', svds),
+        (sklearn_svd, 'svds', svds),
+        (coo_matrix, 'sum_duplicates', column_ordered_sum),
+        (manifold, 'TSNE', compatible_tsne),
+    )
+    with ExitStack() as stack:
+        for obj, name, replacement in replacements:
+            stack.enter_context(patch.object(obj, name, replacement))
+        yield
--- a/scanpy_scripts/_legacy_svds.py
+++ b/scanpy_scripts/_legacy_svds.py
@@ -0,0 +1,111 @@
+"""SciPy 1.8.1 ARPACK reconstruction using the installed eigensolver.
+
+Derived from SciPy 1.8.1, Copyright (c) 2001-2002 Enthought, Inc.,
+2003-2019 SciPy Developers. BSD-3-Clause; see LICENSE.scipy.
+The recipe bounds SciPy's private input validator to >=1.9.3,<1.14.
+Non-ARPACK solvers delegate to the installed SciPy implementation.
+"""
+import numpy as np
+from scipy.sparse.linalg import LinearOperator, eigsh, svds as modern_svds
+from scipy.sparse.linalg._eigen._svds import _iv
+
+
+def _augmented_orthonormal_cols(x, k, random_state):
+    n, m = x.shape
+    y = np.empty((n, m + k), dtype=x.dtype)
+    y[:, :m] = x
+    for i in range(k):
+        v = random_state.standard_normal(size=n)
+        if np.iscomplexobj(x):
+            v = v + 1j * random_state.standard_normal(size=n)
+        for j in range(m + i):
+            u = y[:, j]
+            v -= np.dot(v, u.conj()) / np.dot(u, u.conj()) * u
+        v /= np.sqrt(np.dot(v, v.conj()))
+        y[:, m + i] = v
+    return y
+
+
+def _augmented_orthonormal_rows(x, k, random_state):
+    return _augmented_orthonormal_cols(x.T, k, random_state).T
+
+
+def _herm(x):
+    return x.T.conj()
+
+
+def svds(A, k=6, ncv=None, tol=0, which='LM', v0=None, maxiter=None,
+         return_singular_vectors=True, solver='arpack', random_state=None,
+         options=None):
+    if str(solver).lower() != 'arpack':
+        return modern_svds(
+            A, k=k, ncv=ncv, tol=tol, which=which, v0=v0, maxiter=maxiter,
+            return_singular_vectors=return_singular_vectors, solver=solver,
+            random_state=random_state, options=options,
+        )
+    rs_was_None = random_state is None
+    args = _iv(A, k, ncv, tol, which, v0, maxiter,
+               return_singular_vectors, solver, random_state)
+    (A, k, ncv, tol, which, v0, maxiter,
+     return_singular_vectors, solver, random_state) = args
+    n, m = A.shape
+    if n > m:
+        X_dot = A.matvec
+        X_matmat = A.matmat
+        XH_dot = A.rmatvec
+        XH_mat = A.rmatmat
+    else:
+        X_dot = A.rmatvec
+        X_matmat = A.rmatmat
+        XH_dot = A.matvec
+        XH_mat = A.matmat
+
+    def matvec_XH_X(x):
+        return XH_dot(X_dot(x))
+
+    def matmat_XH_X(x):
+        return XH_mat(X_matmat(x))
+    XH_X = LinearOperator(
+        matvec=matvec_XH_X, dtype=A.dtype, matmat=matmat_XH_X,
+        shape=(min(A.shape), min(A.shape)),
+    )
+    if v0 is None and (not rs_was_None):
+        v0 = random_state.uniform(size=(min(A.shape),))
+    eigvals, eigvec = eigsh(
+        XH_X, k=k, tol=tol ** 2, maxiter=maxiter, ncv=ncv, which=which, v0=v0,
+    )
+    # Recover singular vectors directly from Gramian eigenpairs, as in 1.8.1.
+    # Later SciPy releases add QR/SVD steps that change rounding.
+    eigvals = np.maximum(eigvals.real, 0)
+    t = eigvec.dtype.char.lower()
+    factor = {'f': 1000.0, 'd': 1000000.0}
+    cond = factor[t] * np.finfo(t).eps
+    cutoff = cond * np.max(eigvals)
+    above_cutoff = eigvals > cutoff
+    nlarge = above_cutoff.sum()
+    nsmall = k - nlarge
+    slarge = np.sqrt(eigvals[above_cutoff])
+    s = np.zeros_like(eigvals)
+    s[:nlarge] = slarge
+    if not return_singular_vectors:
+        return np.sort(s)
+    if n > m:
+        vlarge = eigvec[:, above_cutoff]
+        ularge = (X_matmat(vlarge) / slarge
+                  if return_singular_vectors != 'vh' else None)
+        vhlarge = _herm(vlarge)
+    else:
+        ularge = eigvec[:, above_cutoff]
+        vhlarge = (_herm(X_matmat(ularge) / slarge)
+                   if return_singular_vectors != 'u' else None)
+    u = (_augmented_orthonormal_cols(ularge, nsmall, random_state)
+         if ularge is not None else None)
+    vh = (_augmented_orthonormal_rows(vhlarge, nsmall, random_state)
+          if vhlarge is not None else None)
+    indexes_sorted = np.argsort(s)
+    s = s[indexes_sorted]
+    if u is not None:
+        u = u[:, indexes_sorted]
+    if vh is not None:
+        vh = vh[indexes_sorted]
+    return (u, s, vh)
