+"""Temporary dependency overrides, restored on return or exception.
+
+These are process-wide; avoid unrelated concurrent analysis.
+"""
+from contextlib import ExitStack, contextmanager
+from unittest.mock import patch
+
+
+@contextmanager
+def legacy_numerics():
+    import numpy as np
+    from scipy.sparse import coo_matrix
+    import sklearn.manifold as manifold
+
+    original_sum = coo_matrix.sum_duplicates
+    original_tsne = manifold.TSNE
+
+    def column_ordered_sum(self):
+        original_sum(self)
+        order = np.lexsort((self.row, self.col))
+        self.row, self.col = self.row[order], self.col[order]
+        self.data = self.data[order]
+        self.has_canonical_format = True  # SciPy <=1.10 convention
+
+    def compatible_tsne(*args, **kwargs):
+        # Ignored since sklearn 1.1; removed from its constructor in 1.3.
+        kwargs.pop('square_distances', None)
+        return original_tsne(*args, **kwargs)
+
+    with ExitStack() as stack:
+        stack.enter_context(patch.object(coo_matrix, 'sum_duplicates', column_ordered_sum))
+        stack.enter_context(patch.object(manifold, 'TSNE', compatible_tsne))
+        yield
