+"""Preserve scikit-learn 1.2.2's dense KMeans seeding for Harmony.
+
+Adapted from _kmeans_plusplus; see LICENSE.sklearn for copyright and license.
+"""
+from functools import partial
+
+import numpy as np
+from sklearn.cluster import KMeans
+from sklearn.metrics.pairwise import euclidean_distances
+from sklearn.utils import check_random_state
+from sklearn.utils.extmath import row_norms, stable_cumsum
+
+
+def legacy_kmeans_plusplus(data, n_clusters, random_state):
+    """Generate the same unweighted k-means++ seeds as scikit-learn 1.2.2."""
+    random_state = check_random_state(random_state)
+    n_samples, n_features = data.shape
+    squared_norms = row_norms(data, squared=True)
+    centers = np.empty((n_clusters, n_features), dtype=data.dtype)
+    n_local_trials = 2 + int(np.log(n_clusters))
+    first = random_state.randint(n_samples)
+    centers[0] = data[first]
+    closest = euclidean_distances(
+        centers[0, np.newaxis], data, Y_norm_squared=squared_norms, squared=True
+    )
+    potential = closest.sum()
+    for index in range(1, n_clusters):
+        draws = random_state.uniform(size=n_local_trials) * potential
+        candidates = np.searchsorted(stable_cumsum(closest), draws)
+        np.clip(candidates, None, closest.size - 1, out=candidates)
+        distances = euclidean_distances(
+            data[candidates], data, Y_norm_squared=squared_norms, squared=True
+        )
+        np.minimum(closest, distances, out=distances)
+        potentials = distances.sum(axis=1)
+        best = np.argmin(potentials)
+        potential = potentials[best]
+        closest = distances[best]
+        centers[index] = data[candidates[best]]
+    return centers
+
+
+def legacy_cluster_kmeans(data, n_clusters, random_state=0):
+    """Keep the old initializer while using the installed KMeans optimizer."""
+    model = KMeans(
+        n_clusters=n_clusters,
+        init=legacy_kmeans_plusplus,
+        n_init=10,
+        max_iter=25,
+        random_state=random_state,
+    )
+    return model.fit(data).cluster_centers_
+
+
+def harmony_integrate(adata, key, basis='X_pca', adjusted_basis='X_pca_harmony', **kwargs):
+    """A scanpy-scripts adapter using harmonypy's existing cluster_fn hook."""
+    from scanpy.external.pp import harmony_integrate as original
+    if kwargs.get('cluster_fn', 'kmeans') == 'kmeans':
+        kwargs['cluster_fn'] = partial(
+            legacy_cluster_kmeans, random_state=kwargs.get('random_state', 0)
+        )
+    return original(adata, key, basis=basis, adjusted_basis=adjusted_basis, **kwargs)
